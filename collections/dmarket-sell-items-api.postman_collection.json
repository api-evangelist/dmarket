              "body": "{\n  \"items\": [\n    {\n      \"offerId\": \"c3d4e5f6-1234-4abc-9def-7890abcdef12\",\n      \"priceCents\": 1599,\n      \"createdAt\": \"2026-06-17T10:30:00Z\",\n      \"locked\": false,\n      \"attributes\": {\n        \"title\": \"AK-47 | Redline (Field-Tested)\",\n        \"gameId\": \"a8db\",\n        \"categoryPath\": \"rifle/ak-47\",\n        \"tradable\": true,\n        \"cs2Attributes\": {\n          \"exterior\": \"field-tested\",\n          \"floatValue\": 0.2356,\n          \"paintSeed\": 412\n        }\n      }\n    }\n  ],\n  \"total\": 7,\n  \"cursor\": \"\"\n}",
